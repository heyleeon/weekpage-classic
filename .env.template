# Copy to .env (not committed) or export in your shell. All variables are optional.

# Log level filter for the Rust side (tauri-plugin-log). Default: info.
RUST_LOG=info

# Override the data directory (SQLite database + backups). Debug builds default to <repo>/data.
# Release builds always use the OS app data dir and ignore this variable.
WEEKPAGE_DATA_DIR=

# Override the log directory. Debug builds default to <repo>/logs.
WEEKPAGE_LOG_DIR=

# Fake "now" for demos and screenshots, local time "YYYY-MM-DDTHH:MM" (debug builds only).
# The clock keeps ticking from this point, so reminders still fire.
WEEKPAGE_FAKE_NOW=

# Seed demo data into an empty database on startup (debug builds only). Only value: demo
WEEKPAGE_SEED=

# Headless smoke test (debug builds only): show, hide, show again, log window state, exit 0.
WEEKPAGE_DEBUG_SMOKE=

# macOS, debug builds only: skip the NSPanel conversion and use a plain always-on-top window, to
# compare behavior when chasing a window bug. ANY value enables it, an empty one included, so
# leave the line commented out unless you want it.
# WEEKPAGE_NO_PANEL=1

# macOS, debug builds only: when the process has no .app bundle (`tauri dev`, running
# target/debug/weekpage directly), show notifications through `osascript` instead of only logging
# a warning. Only value: 1
# WEEKPAGE_OSASCRIPT_NOTIFY=1
